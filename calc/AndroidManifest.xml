<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.scratch.ioscalc" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22"/>
