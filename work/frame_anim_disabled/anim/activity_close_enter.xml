<?xml version="1.0" encoding="utf-8"?>
<!-- tokens: motion 160-220 ms, decelerate, fade + small scale (design/tokens.md) -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false" android:zAdjustment="top">
    <alpha android:fromAlpha="0.6" android:toAlpha="1" android:interpolator="@android:anim/decelerate_interpolator" android:duration="180"/>
    <scale android:fromXScale="1.0" android:toXScale="1.0" android:fromYScale="1.0" android:toYScale="1.0"
           android:pivotX="50%" android:pivotY="50%" android:interpolator="@android:anim/decelerate_interpolator" android:duration="180"/>
</set>
