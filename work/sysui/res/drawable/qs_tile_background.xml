<?xml version="1.0" encoding="utf-8"?>
<!-- rounded glass tile -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="6dp" android:insetTop="6dp" android:insetRight="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle"><solid android:color="#40FFFFFF"/><corners android:radius="22dp"/></shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="6dp" android:insetTop="6dp" android:insetRight="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle"><solid android:color="#1FFFFFFF"/><corners android:radius="22dp"/></shape>
        </inset>
    </item>
</selector>
